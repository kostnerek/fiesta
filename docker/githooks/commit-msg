#!/bin/sh
set -eu

message="$1"
filtered="$message.fiesta"

awk '
  tolower($0) ~ /^[[:space:]]*co-authored-by:.*(claude|anthropic)/ { next }
  tolower($0) ~ /generated with .*claude/ { next }
  { print }
' "$message" > "$filtered"

awk '
  { lines[NR] = $0 }
  END {
    last = NR
    while (last > 0 && lines[last] ~ /^[[:space:]]*$/) { last-- }
    for (i = 1; i <= last; i++) { print lines[i] }
  }
' "$filtered" > "$message"

rm -f "$filtered"
