#!/usr/bin/env python3
"""Bring the tsoft application up against this ticket's own checkout, or tear it down.

The stack is never left running: it exists for the length of a QA pass and is
stopped afterwards, so a ticket does not inherit the previous ticket's processes.

Services run their compiled output rather than `nest start`, which keeps the
TypeScript compiler resident beside every app: measured 982 MiB per service that
way against 329 MiB this way, and thirteen of the former does not fit on the box.
"""
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.request

INFRA = os.environ.get("FIESTA_INFRA_HOST", "100.101.163.83")
GRPC_PORT = 50051
GATEWAY_PORT = 5001

# service -> the database it owns; gateway owns none. fixture-service reads the
# feed schema, which is what its own e2e configuration does too.
NODE_SERVICES = {
    "betting-service": "betting-service",
    "bonus-service": "bonus-service",
    "chatbot-service": "chatbot-service",
    "commission-service": "commission-service",
    "fixture-service": "feed-service",
    "gaming-service": "gaming-service",
    "gateway-service": None,
    "identity-service": "identity-service",
    "notification-service": "notification-service",
    "reporting-service": "reporting-service",
    "wallet-service": "wallet-service",
}
POSTGRES = {"notification-service"}
# Every service refuses to START unless all nine are set. They need only be set,
# not answering, so the whole stack can start at once with no ordering.
PEERS = ["identity", "wallet", "betting", "bonus", "gaming",
         "commission", "fixture", "notification", "reporting"]

WORKSPACE_HOST = os.environ.get("FIESTA_WORKSPACE_HOST")
PROJECT = "fiesta-ticket-stack"
STACK_DIR = pathlib.Path("/workspace/.fiesta-stack")


def die(message: str) -> None:
    print(f"fiesta-stack: {message}", file=sys.stderr)
    raise SystemExit(1)


def repo_dir() -> pathlib.Path:
    # This command runs the tsoft platform, whose services carry no compose file
    # of their own. A project whose repository ships one is not our business:
    # that file is the authoritative description of what it needs.
    path = pathlib.Path("/workspace/platform")
    if not path.is_dir():
        die("this ticket has no platform checkout, so there is no tsoft stack to run. "
            "If the repository you changed ships its own docker-compose.yml, bring that "
            "up instead — it, not this command, describes what the project needs.")
    return path


def env_lines(service: str, database: str | None, secret: str) -> str:
    lines = [
        "NODE_ENV=development",
        f"SERVICE_NAME={service}",
        "GRPC_HOST=0.0.0.0",
        f"GRPC_PORT={GRPC_PORT}",
        "SYSTEM_HOST=0.0.0.0",
        "SYSTEM_PORT=5002",
        "METRICS_PORT=9100",
        f"REDIS_HOST={INFRA}", "REDIS_PORT=16379",
        f"RABITTMQ_URL=amqp://admin:password@{INFRA}:15672/tsoft",
        f"RABBITMQ_HOST={INFRA}", "RABBITMQ_PORT=15672",
        "RABBITMQ_USER=admin", "RABBITMQ_PASS=password", "RABBITMQ_VHOST=tsoft",
        f"MQTT_HOST={INFRA}", "MQTT_PORT=11883",
        "MQTT_USERNAME=tsoft", "MQTT_PASSWORD=password",
        f"CLICKHOUSE_URL=http://{INFRA}:18123",
        "CLICKHOUSE_USERNAME=tsoft", "CLICKHOUSE_PASSWORD=password",
        f"JWT_SECRET={secret}", "SALT_ROUNDS=10",
        "PRISMA_TRANSACTION_TIMEOUT=15000",
        "DISABLE_CRON_JOBS=true",
        "TRACKIER_TXN_NAMESPACE=10000002",
        # Placeholders only. These integrations are not exercised by API QA, but
        # several services validate the variables as non-empty before they boot.
        "CLOUDINARY_CLOUD_NAME=local", "CLOUDINARY_API_KEY=local",
        "CLOUDINARY_API_SECRET=local",
        "CLOUDINARY_FOLDER_NOTIFICATIONS=local-notifications",
        "CLOUDINARY_FOLDER_BONUS_BANNERS=local-bonus-banners",
        "FIREBASE_PROJECT_TYPE=service_account", "FIREBASE_PROJECT_ID=local",
        "FIREBASE_PRIVATE_KEY_ID=local", "FIREBASE_CLIENT_EMAIL=local@local.invalid",
        "FIREBASE_STORAGE_BUCKET=local.appspot.com", "FIREBASE_CLIENT_ID=0",
        "FIREBASE_AUTH_URL=https://accounts.google.com/o/oauth2/auth",
        "FIREBASE_TOKEN_URL=https://oauth2.googleapis.com/token",
        "FIREBASE_AUTH_PROVIDER=https://www.googleapis.com/oauth2/v1/certs",
        "FIREBASE_CLIENT_URL=https://www.googleapis.com/robot/v1/metadata/x509/local",
        "FIREBASE_DOMAIN=local.invalid",
    ]
    if database:
        if service in POSTGRES:
            lines += ["DB_TYPE=postgres", f"DB_HOST={INFRA}", "DB_PORT=15432",
                      "DB_USERNAME=tsoft", "DB_PASSWORD=password",
                      f"DB_DATABASE={database}",
                      f"DATABASE_URL=postgresql://tsoft:password@{INFRA}:15432/{database}"]
        else:
            lines += ["DB_TYPE=mysql", f"DB_HOST={INFRA}", "DB_PORT=13306",
                      "DB_USERNAME=tsoft", "DB_PASSWORD=password",
                      f"DB_DATABASE={database}",
                      f"DATABASE_URL=mysql://tsoft:password@{INFRA}:13306/{database}"]
    if service == "gateway-service":
        lines.append(f"PORT={GATEWAY_PORT}")
    for peer in PEERS:
        lines.append(f"{peer.upper()}_SERVICE_URL={peer}-service:{GRPC_PORT}")
    lines.append(f"FEEDS_SERVICE_GRPC_URI=feed-service:{GRPC_PORT}")
    return "\n".join(lines) + "\n"


def firebase_key() -> str:
    key = subprocess.run(["openssl", "genrsa", "2048"], capture_output=True,
                         text=True, check=True).stdout.strip()
    return key.replace("\n", "\\n")


def generate() -> None:
    (STACK_DIR / "env").mkdir(parents=True, exist_ok=True)
    secret = os.urandom(32).hex()
    key = firebase_key()
    for service, database in list(NODE_SERVICES.items()) + [("feed-service", "feed-service")]:
        body = env_lines(service, database, secret) + f"FIREBASE_PRIVATE_KEY={key}\n"
        (STACK_DIR / "env" / f"{service}.env").write_text(body)

    compose = ["name: " + PROJECT, "", "services:"]
    for service in NODE_SERVICES:
        compose += [
            f"  {service}:",
            "    image: fiesta-agent:latest",
            f"    container_name: {service}",
            f"    hostname: {service}",
            # The generated gRPC clients embed a cwd-relative proto path that
            # resolves only from the service directory.
            f"    working_dir: /workspace/platform/apps/{service}",
            '    entrypoint: ["node", "dist/main.js"]',
            f"    env_file: [{WORKSPACE_HOST}/.fiesta-stack/env/{service}.env]",
            f"    volumes: ['{WORKSPACE_HOST}:/workspace']",
            "    networks: [stack]",
        ]
        if service == "gateway-service":
            compose.append(f'    ports: ["{GATEWAY_PORT}:{GATEWAY_PORT}"]')
    compose += [
        "  feed-service:",
        "    image: fiesta-agent:latest",
        "    container_name: feed-service",
        "    hostname: feed-service",
        "    working_dir: /workspace/platform/apps/feed-service",
        '    entrypoint: ["./feed-service"]',
        f"    env_file: [{WORKSPACE_HOST}/.fiesta-stack/env/feed-service.env]",
        f"    volumes: ['{WORKSPACE_HOST}:/workspace']",
        "    networks: [stack]",
        "", "networks:", "  stack:", "    driver: bridge", "",
    ]
    (STACK_DIR / "docker-compose.yml").write_text("\n".join(compose))


def run(args: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(args, **kw)


def build() -> None:
    repo = repo_dir()
    print("fiesta-stack: building services (nx caches, so unchanged ones are free)")
    projects = ",".join(NODE_SERVICES)
    if run(["pnpm", "nx", "run-many", "--target=build", f"--projects={projects}"],
           cwd=repo).returncode != 0:
        die("the build failed — fix that before running QA against the stack")
    if run(["go", "build", "-o", "feed-service", "."],
           cwd=repo / "apps" / "feed-service").returncode != 0:
        die("feed-service (Go) failed to build")


def compose(*args: str) -> int:
    return run(["docker", "compose", "-f", str(STACK_DIR / "docker-compose.yml"),
                *args]).returncode


def wait_for_gateway(timeout: int = 240) -> None:
    url = f"http://gateway-service:{GATEWAY_PORT}/api/v2/auth/login"
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            request = urllib.request.Request(
                url, data=b"{}", method="POST",
                headers={"content-type": "application/json", "sbe-client-id": "1"})
            urllib.request.urlopen(request, timeout=5).read()
            print("fiesta-stack: gateway is answering")
            return
        except urllib.error.HTTPError:
            # Any HTTP status means the REST surface is up and routing.
            print("fiesta-stack: gateway is answering")
            return
        except Exception:
            time.sleep(5)
    die("the gateway never answered — run `fiesta-stack status` to see which service failed")


def up() -> None:
    if not WORKSPACE_HOST:
        die("FIESTA_WORKSPACE_HOST is not set; this must run inside a ticket container")
    build()
    generate()
    compose("up", "-d", "--remove-orphans")
    wait_for_gateway()
    print(f"fiesta-stack: up. REST at http://gateway-service:{GATEWAY_PORT}/api/v2")


def down() -> None:
    compose("down", "--remove-orphans", "-t", "5")
    print("fiesta-stack: down")


def status() -> None:
    compose("ps")
    print()
    for service in list(NODE_SERVICES) + ["feed-service"]:
        log = run(["docker", "logs", "--tail", "40", service],
                  capture_output=True, text=True)
        text = log.stdout + log.stderr
        if "successfully started" in text:
            verdict = "up"
        elif "is required but not set" in text:
            verdict = "missing env"
        elif "Error" in text or "error" in text:
            verdict = "error — docker logs " + service
        else:
            verdict = "no start marker"
        print(f"  {service:22} {verdict}")


COMMANDS = {"up": up, "down": down, "status": status}

if __name__ == "__main__":
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command not in COMMANDS:
        die(f"usage: fiesta-stack {'|'.join(COMMANDS)}")
    COMMANDS[command]()
